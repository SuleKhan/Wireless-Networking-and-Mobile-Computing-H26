diff --git a/src/convcode.cc b/src/convcode.cc
index 12cd0f4..2bf4297 100644
--- a/src/convcode.cc
+++ b/src/convcode.cc
@@ -45,7 +45,7 @@ constexpr  auto         ab_generators = std::array<unsigned,12>
     063543, 075307, 052547, 045627, 067657, 051757
   };
 
-constexpr  unsigned int ab_rate       = ab_generators.size();
+static     unsigned int ab_rate       = ab_generators.size();   /* runtime: --generators */
 constexpr  unsigned int order         = 15;
 
 /*
@@ -59,6 +59,15 @@ constexpr  unsigned int order       = 18;
 constexpr  auto         generators  = std::array<unsigned,3> { 0552137, 0614671, 0772233 };
 */
 
+bool
+conv_set_ab_rate (unsigned int n)
+{
+  if (n < 2 || n > ab_generators.size() || n % 2 != 0)
+    return false;
+  ab_rate = n;
+  return true;
+}
+
 constexpr  unsigned int state_count = (1 << order);
 constexpr  unsigned int state_mask  = (1 << order) - 1;
 
@@ -92,7 +101,7 @@ get_block_type_generators (ConvBlockType block_type)
   else
     {
       assert (block_type == ConvBlockType::ab);
-      generators.assign (ab_generators.begin(), ab_generators.end());
+      generators.assign (ab_generators.begin(), ab_generators.begin() + ab_rate);
     }
   return generators;
 }
